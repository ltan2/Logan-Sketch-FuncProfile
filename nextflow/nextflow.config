// See main.nf and ../design/latest_design-doc.md for context.

manifest {
    name        = 'logan-sketch-funcprofile'
    description = 'Fetch Logan unitig/contig assemblies per accession; run sourmash sketch and funprofiler.'
    mainScript  = 'main.nf'
}

params {
    // Inputs produced or stored at the repository root. projectDir is the nextflow/
    // directory, so repository-level assets are resolved through its parent.
    accessions   = "${projectDir}/../wgs_metagenome_accessions.txt"
    ko_sig       = "${projectDir}/../KOs_sketched_scaled_1000.sig.zip"
    outdir       = "${launchDir}/results"

    // Analysis defaults derived from the original logan-subworkflow.sh implementation.
    min_compressed_bytes    = 200     // avoids attempting to decompress effectively empty inputs
    sourmash_ksize           = 31      // logan-subworkflow.sh: sourmash sketch dna -p k=31,...
    sourmash_scale           = 1000    // logan-subworkflow.sh: sourmash sketch dna -p ...,scaled=1000,...
    funprofiler_ksize        = 11      // logan-subworkflow.sh: funcprofiler ... 11 1000 ...
    funprofiler_scale        = 1000    // logan-subworkflow.sh: funcprofiler ... 11 1000 ...
    // Sequence types FUNPROFILER runs on (comma-separated). Both by default: contigs KOs are NOT a subset of
    // unitigs KOs (99.3-99.5% overlap, most accessions have a contigs-only KO, and abundances
    // differ).
    funprofiler_seq_types    = 'unitigs,contigs'

    // Whether FETCH_LOGAN gives up on an accession (ignore) or aborts the whole run
    // (terminate) once its retries are exhausted. See the 'benchmark' profile below.
    fetch_exhausted_strategy = 'terminate'

    // Sharding is performed before launch (design/latest_design-doc.md section 4.3), not in
    // this configuration. Every accession in `params.accessions` becomes its own task;
    // run a bounded shard by pointing --accessions at a smaller manifest.
}

// bin/ scripts (write_ledger_row.sh) are put on PATH for every process automatically.

process {
    // Single shared multi-core server, not a cluster.
    executor = 'local'

    // Reserved, not enforced (local executor). Measured peak_rss on n=5000 was <0.5 GB at p95 for
    // every stage in this pipeline, so 1 GB is a comfortable per-task reservation and keeps the
    // executor{} cap below from being exhausted by hundreds of short tasks.
    memory = '1 GB'

    // FETCH_LOGAN retries on transient S3/network failures; analysis processes keep the
    // default 'terminate' behaviour so a real bug is visible instead of retried away.
    withName: FETCH_LOGAN {
        errorStrategy = 'retry'
        maxRetries    = 2
        // Throttle concurrent S3 pulls independently of analysis parallelism -- the
        // shared-server rules require agreeing on a download concurrency limit before a large
        // run; this is that limit, not a guess about total scale. Raised from 10: at 10, each
        // accession's fetch finishes in ~15 s, so the limit isn't the batch bottleneck, but
        // large accessions take far longer to download.
        maxForks = 50
    }

    withName: SOURMASH_SKETCH {
        cpus = 3
        memory = '1 GB'
    }

    withName: FUNPROFILER {
        cpus = 3
        memory = '1 GB'
    }

    withName: CLEANUP_FASTA {
        // Just an `rm` -- keep it cheap so it never competes with real work for a slot.
        cpus   = 1
        memory = '256 MB'
    }
}

executor {
    // Local-executor pool size, in declared (not actual) memory. The server has ~3023 GB RAM
    // shared with other users, and Nextflow otherwise sizes the pool to the whole machine.
    // Every process here declares 1 GB or less, so this cap bounds concurrency at ~500
    // simultaneous tasks; in practice the CPU count is the binding constraint. Check the RAM
    // panel of plot_benchmark.py's 04_cpu_utilization for swap after a large run and lower if any.
    memory = '2700 GB'
    cpus = 700
}

profiles {
    standard {
        // Default profile: local execution against params.accessions as given.
    }

    test {
        // Smoke-test subset for CI / local dev. These are real accessions taken from the
        // existing manifest; none is yet confirmed empty -- add one here once identified
        // from a real run.
        params.accessions = "${projectDir}/test/accessions_smoke.txt"
    }

    benchmark {
        // Benchmarking runs many independent accessions purely to measure throughput --
        // one accession hitting an unexpected error (bad upstream data, a transient tool
        // bug, etc.) shouldn't abort timing for the rest of the batch the way the
        // standard profile's default 'terminate' does. Scoped to this profile so a real
        // production run still fails loudly per the reasoning in modules/fetch.nf.
        process.errorStrategy = 'ignore'
        params.fetch_exhausted_strategy = 'ignore'

        // Benchmark sweeps run tens of thousands of independent tasks with no per-process
        // maxForks cap (besides FETCH_LOGAN), so every task's decompressed FASTA / sketch /
        // KO profile otherwise accumulates in -work-dir for the whole run. Scoped to this
        // profile (not 'standard') so a real production run still keeps its work dirs around
        // for debugging.
        cleanup = true
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.tsv"
    overwrite = true
    // 'tag' carries accession[.seq_type] (see each process's `tag` directive) -- that's how
    // benchmark/plot_benchmark.py recovers per-accession/seq_type identity from the trace.
    // cpus/%cpu/memory/peak_rss/read_bytes/write_bytes feed the CPU- and
    // memory/disk-utilization plots; submit/start/complete feed the task-timeline and
    // throughput plots.
    fields = 'process,tag,status,cpus,memory,%cpu,submit,start,complete,realtime,peak_rss,read_bytes,write_bytes'
    // Raw (unitless) numbers instead of Nextflow's human-formatted strings (e.g. '1.2 GB',
    // '1h 2m 3s') -- benchmark/plot_benchmark.py parses these fields as plain numbers
    // (milliseconds, bytes, bare percentages) and depends on this being on.
    raw = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
