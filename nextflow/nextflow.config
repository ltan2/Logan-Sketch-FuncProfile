// See main.nf and ../design/latest_design-doc.md for context.

manifest {
    name        = 'logan-sketch-funcprofile'
    description = 'Fetch Logan unitig/contig assemblies per accession; run sourmash sketch and funprofiler.'
    mainScript  = 'main.nf'
}

params {
    // Inputs produced or stored at the repository root. projectDir is the nextflow/
    // directory, so repository-level assets are resolved through its parent.
    accessions   = "${projectDir}/../wgs_metagenome_accessions.txt"
    ko_sig       = "${projectDir}/../KOs_sketched_scaled_1000.sig.zip"
    outdir       = "${launchDir}/results"

    // Where the per-run trace and HTML report go, and what distinguishes one run's files from
    // the next's. A full run is executed as a sequence of shards that all publish into one
    // outdir (nextflow/run_full.sh), so each shard passes its own run_tag and a shared
    // trace_dir; that keeps every shard's trace instead of overwriting the previous one, which
    // is what benchmark/live_monitor.py reads to plot the whole run as it happens. Unset by
    // default, so a plain `nextflow run` still writes results/pipeline_trace.tsv as before.
    trace_dir    = null
    run_tag      = null

    // The HTML report embeds one row per task. Fine for a test or a shard; an unsharded run
    // over the full manifest is ~9.7M tasks (192,629 measured for shard_00001's 24,718
    // accessions, x50.5), which produces a file of gigabytes that no browser will open. The
    // 'full' profile turns it off; the TSV trace still records every task and is what
    // benchmark/live_monitor.py reads. Set as a param because the report{} block below is
    // declared after profiles{} and would otherwise win.
    enable_report = true

    // Analysis defaults derived from the original logan-subworkflow.sh implementation.
    min_compressed_bytes    = 200     // avoids attempting to decompress effectively empty inputs
    sourmash_ksize           = 31      // logan-subworkflow.sh: sourmash sketch dna -p k=31,...
    sourmash_scale           = 1000    // logan-subworkflow.sh: sourmash sketch dna -p ...,scaled=1000,...

    // Protein sketch (6-frame translation of the same FASTA) published next to the DNA one.
    // k and scaled have to match the collection the sketch will be compared against, so they
    // default to the KO collection's 11/1000 -- the same values funprofiler_ksize/scale pass to
    // funcprofiler, which makes exactly this sketch internally before its prefetch.
    
    sourmash_protein_ksize   = 11
    sourmash_protein_scale   = 1000
    funprofiler_ksize        = 11      // logan-subworkflow.sh: funcprofiler ... 11 1000 ...
    funprofiler_scale        = 1000    // logan-subworkflow.sh: funcprofiler ... 11 1000 ...
    
    funprofiler_seq_types    = 'unitigs,contigs'


    // Whether FETCH_LOGAN gives up on an accession (ignore) or aborts the whole run
    // (terminate) once its retries are exhausted. See the 'benchmark' profile below.
    fetch_exhausted_strategy = 'terminate'

    // Sharding is performed before launch (design/latest_design-doc.md section 4.3), not in
    // this configuration. Every accession in `params.accessions` becomes its own task;
    // run a bounded shard by pointing --accessions at a smaller manifest.
}

// Thread caps for every task. sourmash's own compute is Rust and single-threaded for our
// commands, but importing it pulls in numpy/OpenBLAS, whose pool spins across ~5 cores per
// process doing no useful work -- measured 11.82 core-s vs 2.27 for the same sketch, with the
// capped run finishing marginally FASTER in wall clock. At ~500 concurrent tasks that was
// several hundred cores of pure overhead and a large share of the 30-40% system time this
// server was showing. RAYON_NUM_THREADS matches what the lab's stream_sketcher sets
// (sourmash_threads: 1); the rest close the same door for the other BLAS backends.
env {
    OPENBLAS_NUM_THREADS = 1
    RAYON_NUM_THREADS    = 1
    OMP_NUM_THREADS      = 1
    MKL_NUM_THREADS      = 1
    NUMEXPR_NUM_THREADS  = 1
}

// bin/ scripts (write_ledger_row.sh) are put on PATH for every process automatically.

process {
    // Single shared multi-core server, not a cluster.
    executor = 'local'

    // Reserved, not enforced (local executor). Measured peak_rss on n=5000 was <0.5 GB at p95 for
    // every stage in this pipeline, so 1 GB is a comfortable per-task reservation and keeps the
    // executor{} cap below from being exhausted by hundreds of short tasks.
    memory = '1 GB'

    // FETCH_LOGAN retries on transient S3/network failures; analysis processes keep the
    // default 'terminate' behaviour so a real bug is visible instead of retried away.
    withName: FETCH_LOGAN {
        errorStrategy = 'retry'
        maxRetries    = 2
        // Throttle concurrent S3 pulls independently of analysis parallelism -- the
        // shared-server rules require agreeing on a download concurrency limit before a large
        // run; this is that limit, not a guess about total scale.
        //
        // 25, lowered from 100. The earlier value was calibrated on a 1,000-accession
        // benchmark where 50 forks pulled everything within the first 5.6 minutes of a
        // 96-minute run -- fetching looked like ~3% of the work and never on the critical
        // path, so the cap only had to stay inside the shared 20 Gbit/s bond. That reasoning
        // does not survive a full-size shard, where fetch never finishes and instead competes
        // for storage bandwidth for the whole run.
        //
        // Measured 17 minutes into a 24,718-accession shard at maxForks = 100: fetch
        // completed 193 accessions/min while SOURMASH_SKETCH drained 67/min, so the front of
        // the pipeline ran ~6x ahead of the back. 7,585 .zst files (1.2 TB) sat fetched and
        // undecompressed, the work directory reached 3.0 TB, and the ~2.7 GB/s of writeback
        // that produced left the machine at 17% sys and 10.4% iowait with only 531 of 768
        // cores busy -- i.e. the surplus downloading was costing analysis throughput, not
        // adding any.
        //
        // At the measured drain rate (~34 accessions/min) and a 14.5s median fetch, ~10
        // concurrent pulls sustain the pipeline; 25 leaves ~3x headroom for the 67s p95 tail
        // without letting the backlog grow again. This is a rate limit, not a bandwidth one:
        // an individual accession's download is bounded by its own stream (~150 MB/s).
        maxForks = 25
    }

    // Bound how far decompression may run ahead of the analysis that consumes its output.
    // maxForks on FETCH_LOGAN alone does not do this: one fetched accession expands into a
    // much larger FASTA, and nothing else in the graph throttles that expansion. Measured on
    // the same 24,718-accession shard, 4,943 decompressed FASTAs (1.9 TB) were live at once
    // against ~200 being analysed, and DECOMPRESS_FASTA -- which should be CPU-bound on zstd
    // -- averaged 0.16 cores with an 88s p95 realtime because it spent its life blocked on
    // writeback. 50 is comfortably above the ~34 accessions/min the analysis drains, so it
    // caps the live FASTA backlog without ever making decompression the critical path.
    withName: DECOMPRESS_FASTA {
        maxForks = 50
    }

    // 2, not 3: these reservations are what the local executor counts against executor.cpus,
    // so they set how many analysis tasks run at once (700 / cpus). Measured over a
    // 1,000-accession benchmark, the median task actually used 2.1 cores (SOURMASH_SKETCH,
    // which threads) and 1.0 (FUNPROFILER, which does not) -- reserving 3 exhausted the slot
    // pool at 233 tasks while only ~480 of 700 cores were busy. At 2 the pool allows ~350
    // tasks, still ~525 cores at the measured average, so it fills the machine rather than
    // the accounting.
    // cpus = 1, and no maxForks: this is a queue, not a set of reserved lanes.
    //
    // 1, not 2, because 1 is what these tasks use once the env{} thread caps above are in
    // place. Measured on a 468 MB FASTA: `sourmash sketch dna` took 11.82 core-s uncapped and
    // 2.27 capped; `sketch translate` 12.67 vs 2.29 -- a ~5x cut in CPU for no wall-clock
    // cost (2.59s -> 2.27s, 2.40s -> 2.31s). sourmash was spending four cores' worth of
    // thread-pool overhead per core of real work, which is what made a 2-cpu declaration look
    // plausible and still left the pool "full" while the machine was half idle.
    //
    // With honest declarations a declared slot is a real core, so executor.cpus below is a
    // core budget and Nextflow's task queue does the scheduling: a finished task frees a slot
    // the next one takes at once, regardless of size. No maxForks here on purpose -- any cap
    // strands capacity as soon as the work it reserves runs out.
    withName: SOURMASH_SKETCH {
        cpus   = 1
        memory = '1 GB'
    }

    withName: FUNPROFILER {
        cpus   = 1
        memory = '1 GB'
    }


    withName: CLEANUP_FASTA {
        // Just an `rm` -- keep it cheap so it never competes with real work for a slot.
        cpus   = 1
        memory = '256 MB'
    }
}

executor {
    // Declared-memory pool. Every process here declares 1 GB or less and measured peak_rss was
    // <0.5 GB at p95, so this has never been the binding constraint -- it is a backstop against
    // Nextflow sizing the pool to the whole of a shared 3 TB machine. Check the RAM panel of
    // plot_benchmark.py's 04_cpu_utilization for swap after a large run and lower if any.
    memory = '2700 GB'

    // A core budget. With env{} capping the thread pools and every process declaring the 1 cpu
    // it actually uses, one unit here is one real core -- so this is simply "how much of the
    // server may this run take", and it is the only knob that needs to change to answer that.
    //
    // 500: the same footprint this run already had (~516 cores), but now spent on work rather
    // than thread-pool churn -- the env{} caps cut sourmash's CPU ~5x (11.82 core-s -> 2.27 for
    // the same sketch), so the machine sees no change while throughput roughly doubles. Lower
    // it if the lab needs the cores back; nothing else has to change with it.
    //
    // History worth not repeating: this was 780, then 1000, then 650, then 790, all while
    // processes declared 2 cpus and sourmash silently spread over ~5. Every value was wrong
    // because the unit was fiction -- at 1000 the pool admitted 543 tasks, put 1,334 runnable
    // threads on 768 cores, and burned 37.6% of the machine in the kernel. Do not re-tune this
    // number against a task mix whose declarations have not been re-measured; fix the
    // declaration first, then this becomes obvious.
    //
    // Ceiling behind this one: the local executor's queueSize (`capacity`) defaults to the CPU
    // count, 768. At cpus=1 this budget is also the task count, so going above 768 needs
    // executor.queueSize raised as well.
    cpus = 500
}


profiles {
    standard {
        // Default profile: local execution against params.accessions as given.
    }

    test {
        // Smoke-test subset for CI / local dev. These are real accessions taken from the
        // existing manifest; none is yet confirmed empty -- add one here once identified
        // from a real run.
        params.accessions = "${projectDir}/test/accessions_smoke.txt"
    }

    full {
        // Production sweep over the whole manifest, driven by nextflow/run_full.sh
        // (see how_to_run.md).
        //
        // No HTML report here. It embeds one row per task, and an unsharded run over the full
        // manifest is ~9.7M tasks (measured: 192,629 tasks for shard_00001's 24,718
        // accessions, x50.5) -- the file would be gigabytes and would not open. The TSV trace
        // still records everything, and benchmark/live_monitor.py reads that.
        params.enable_report = false
        //
        // A run of this size will meet accessions whose Logan objects can't be fetched even
        // after retries -- a removed/embargoed SRA record, an object that 404s for reasons the
        // fetch module's "does not exist" check doesn't cover. Aborting a multi-week run for one
        // of those is worse than dropping it: run_full.sh recovers every FAILED task from the
        // shard's trace into state/shard_XXXX.failed.txt, so nothing disappears silently, and
        // those accessions can be re-run later as their own manifest.
        params.fetch_exhausted_strategy = 'ignore'

        // Deliberately NOT `cleanup = true` (unlike the benchmark profile): cleanup deletes the
        // work directory at the end of a run, and an interrupted shard's work directory is what
        // its next attempt resumes from. CLEANUP_FASTA already deletes the big intermediates
        // per task while the shard runs, and run_full.sh deletes a shard's work directory once
        // that shard is complete.
    }

    benchmark {
        // Benchmarking runs many independent accessions purely to measure throughput --
        // one accession hitting an unexpected error (bad upstream data, a transient tool
        // bug, etc.) shouldn't abort timing for the rest of the batch the way the
        // standard profile's default 'terminate' does. Scoped to this profile so a real
        // production run still fails loudly per the reasoning in modules/fetch.nf.
        process.errorStrategy = 'ignore'
        params.fetch_exhausted_strategy = 'ignore'

        // Benchmark sweeps run tens of thousands of independent tasks with no per-process
        // maxForks cap (besides FETCH_LOGAN), so every task's decompressed FASTA / sketch /
        // KO profile otherwise accumulates in -work-dir for the whole run. Scoped to this
        // profile (not 'standard') so a real production run still keeps its work dirs around
        // for debugging.
        cleanup = true
    }
}

// Trace/report file names: <trace_dir>/pipeline_trace[.<run_tag>].tsv, defaulting to the run's
// own outdir and no tag. Written inline rather than via `def` variables: Nextflow's config
// parser rejects variable declarations mixed with config statements.
trace {
    enabled   = true
    file      = "${params.trace_dir ?: params.outdir}/pipeline_trace${params.run_tag ? '.' + params.run_tag : ''}.tsv"
    overwrite = true
    // 'tag' carries accession[.seq_type] (see each process's `tag` directive) -- that's how
    // benchmark/plot_benchmark.py recovers per-accession/seq_type identity from the trace.
    // cpus/%cpu/memory/peak_rss/read_bytes/write_bytes feed the CPU- and
    // memory/disk-utilization plots; submit/start/complete feed the task-timeline and
    // throughput plots.
    fields = 'process,tag,status,cpus,memory,%cpu,submit,start,complete,realtime,peak_rss,read_bytes,write_bytes'
    // Raw (unitless) numbers instead of Nextflow's human-formatted strings (e.g. '1.2 GB',
    // '1h 2m 3s') -- benchmark/plot_benchmark.py parses these fields as plain numbers
    // (milliseconds, bytes, bare percentages) and depends on this being on.
    raw = true
}

report {
    enabled   = params.enable_report
    file      = "${params.trace_dir ?: params.outdir}/pipeline_report${params.run_tag ? '.' + params.run_tag : ''}.html"
    overwrite = true
}
